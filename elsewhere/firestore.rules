rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(tripId) {
      return signedIn() && exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid));
    }
    function isOwner(tripId) {
      return isMember(tripId) && get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.role == 'owner';
    }
    function validName(value) { return value is string && value.size() > 0 && value.size() <= 80; }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt'])
        && validName(request.resource.data.displayName)
        && request.resource.data.email is string;
      allow delete: if false;
    }

    // Invite codes are intentionally readable by authenticated users who know
    // the code. Listing all codes is never allowed.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['tripId', 'createdBy', 'active', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.tripId is string
        && getAfter(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.createdBy == request.auth.uid;
      allow update: if signedIn() && resource.data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && request.resource.data.active == false;
      allow delete: if false;
    }

    match /trips/{tripId} {
      allow get: if isMember(tripId);
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 1
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update: if (
        isOwner(tripId) && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['budgetMinor'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inviteCode'])
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && request.resource.data.memberIds is list
            && request.resource.data.memberIds.size() <= resource.data.memberIds.size())
        )
      ) || (
        // A non-owner may leave only by removing their own membership.
        signedIn()
        && request.auth.uid in resource.data.memberIds
        && get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.role == 'member'
        && !(request.auth.uid in request.resource.data.memberIds)
        && !existsAfter(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
      ) || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.auth.uid in request.resource.data.memberIds
        && !(request.auth.uid in resource.data.memberIds)
        && getAfter(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.inviteCode is string
        && get(/databases/$(database)/documents/invites/$(getAfter(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.inviteCode)).data.tripId == tripId
        && get(/databases/$(database)/documents/invites/$(getAfter(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.inviteCode)).data.active == true
      );
      allow delete: if isOwner(tripId);

      match /members/{uid} {
        allow read: if isMember(tripId);
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.userId == uid
          && request.resource.data.displayName is string
          && request.resource.data.role == 'member'
          && request.resource.data.inviteCode is string
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.active == true
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.tripId == tripId;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.userId == uid
          && request.resource.data.role == 'owner'
          && getAfter(/databases/$(database)/documents/trips/$(tripId)).data.createdBy == uid;
        allow update: if isMember(tripId) && (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
          || isOwner(tripId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']));
        allow delete: if isOwner(tripId) && uid != request.auth.uid
          || signedIn() && request.auth.uid == uid
          && resource.data.role == 'member';
      }

      match /itinerary/{activityId} {
        allow read: if isMember(tripId);
        allow create: if isMember(tripId) && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.title is string && request.resource.data.title.size() > 0;
        allow update: if isMember(tripId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','location','date','time','costMinor','notes','updatedAt']);
        allow delete: if isMember(tripId) && resource.data.createdBy == request.auth.uid;
      }
      match /packingItems/{itemId} {
        allow read: if isMember(tripId);
        allow create: if isMember(tripId) && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() > 0;
        allow update: if isMember(tripId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['packed','packedBy']);
        allow delete: if isMember(tripId) && resource.data.addedBy == request.auth.uid;
      }
      match /expenses/{expenseId} {
        allow read: if isMember(tripId);
        allow create: if isMember(tripId) && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.amountMinor is int && request.resource.data.amountMinor > 0
          && request.resource.data.paidBy in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && request.resource.data.participantIds is list && request.resource.data.shares is map;
        allow update: if false;
        allow delete: if isMember(tripId) && resource.data.createdBy == request.auth.uid;
      }
      match /settlements/{settlementId} {
        allow read: if isMember(tripId);
        allow create: if isMember(tripId) && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.fromUserId is string && request.resource.data.toUserId is string
          && request.resource.data.fromUserId != request.resource.data.toUserId
          && request.resource.data.amountMinor is int && request.resource.data.amountMinor > 0;
        allow update, delete: if false;
      }
    }
  }
}
